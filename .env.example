# Public URL of the site, no trailing slash (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Set to true ONLY for the live production build. Anything else = noindex + robots disallow.
NEXT_PUBLIC_SITE_LIVE=false
# Where forms POST. Empty = /api/enquiry/ (the Vercel Function that emails through Resend).
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# Form email (Vercel Function api/enquiry.js). Set these in Vercel's environment, never in code.
# RESEND_API_KEY=re_xxx
# MAIL_TO=info@goyalsgroup.co.in
# MAIL_FROM="Goyals Group Website <website@your-verified-domain>"
